<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMS не обовʼязкова: APK ставиться й на планшет без модема, просто тоді
         роль засобу обміну система не пропонує. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Роль ROLE_SMS видає ці дозволи разом із собою (permission-сети sms,
         phone, contacts у roles.xml бази), але застосунок мусить їх оголосити. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- MMS поки не вміємо, але без цих двох система не доставляє WAP_PUSH_DELIVER,
         а отже застосунок не проходить вимоги ролі. -->
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TesseraMessaging">

        <activity
            android:name=".MessagingActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- SENDTO/smsto — один із чотирьох компонентів, яких вимагає
                 ROLE_SMS (roles.xml нашої бази). Решту схем додаємо для
                 справжньої поведінки: «написати» з «Контактів» приходить саме
                 так. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>

            <!-- ACTION_SEND з текстом — «Поділитися» в інший застосунок. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Другий обовʼязковий компонент ролі: доставлення SMS. Поки ми
             default, пишемо повідомлення в провайдер самі — платформа це
             робить лише тоді, коли застосунку-отримувачу немає. -->
        <receiver
            android:name=".receive.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Третій: WAP push (MMS-повідомлення). -->
        <receiver
            android:name=".receive.WapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Четвертий: швидка відповідь на вхідний дзвінок. -->
        <service
            android:name=".RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="smsto" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Результати надсилання (sent/delivery PendingIntent) приходять сюди,
             а не в активність: користувач міг уже вийти з екрана. -->
        <receiver
            android:name=".receive.SendStatusReceiver"
            android:exported="false" />
    </application>
</manifest>
