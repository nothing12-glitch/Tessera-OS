<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Системний майстер першого запуску, а не звичайний застосунок.

      Цей дозвіл і є різниця між «екран, який хтось відкрив» і «екран, який
      система відкриває сама»: `device_provisioned` і `ui_night_mode` живуть у
      Settings.Global / Settings.Secure, а вони `signature|privileged`. Тому
      модуль лежить у system_ext/priv-app і має запис у
      privapp-permissions-tessera-welcome.xml (див. Android.bp).
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!--
      Другий привілей — саме для теми, і він з'явився тут не «на всяк випадок».
      Живий прогін 2026-10-26 на userdebug-образі: `UiModeManager.setNightMode()`
      доходив до system_server і отримував мовчки відкинутий запит —
      `E/UiModeManager: Night mode locked, requires MODIFY_DAY_NIGHT_MODE
      permission`, а `dumpsys uimode` лишався на `mNightMode=1 (no)`. Сирий
      запис `ui_night_mode` у Secure те не ламає: значення там було, а телефон —
      ні. Дозвіл `signature|privileged`, тому маніфест і дозвільний список мають
      називати його однаково — інакше на `enforce`-образі система не підніметься.
    -->
    <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" />

    <!--
      Звичайний дозвіл, а не привілей: потрібен лише на два поштовхи в кінці
      майстра. Звук дає ToneGenerator без дозволів.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TesseraWelcome">

        <!--
          ЖОДНОГО фільтра з CATEGORY_LAUNCHER. Це принципово: у майстра
          першого запуску не має бути іконки в шухляді, бо після налаштування
          він не існує для користувача. Єдиний вхід — категорія SETUP_WIZARD.

          priority=1000 — спроба перебрати чергу у майстра бази. Хто саме
          тримає цю категорію в LineageOS 22.2 і чи перемагає тут число,
          перевіряється на зібраному образі; див. README.md.
        -->
        <activity
            android:name=".WelcomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SETUP_WIZARD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
