<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Той самий підхід, що й у решти наших застосунків: системний
         DeviceDefault дає день/ніч і Monet для першого кадру, прозорі панелі —
         щоб edge-to-edge не лишив чорних смуг. -->
    <style name="Theme.TesseraWelcome" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
