<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Той самий підхід, що у решти наших застосунків: DeviceDefault дає
         день/ніч і Monet для першого кадру, прозорі панелі — щоб edge-to-edge
         не лишив чорних смуг. -->
    <style name="Theme.TesseraHalo" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
