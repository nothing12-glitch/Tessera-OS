<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Камера необовʼязкова: APK має ставитися й на віртуальну машину без
         камери. Там екран показує, що камери немає, замість відмови
         встановлювати застосунок. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- Дозвіл CAMERA сам по собі натякає на обовʼязкову камеру; кажемо прямо,
         що ні, інакше пакунок виглядає так, наче без оптики не запускається. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Лише для відео: звук пишемо, тільки коли користувач у режимі запису. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Знімки кладемо через MediaStore, тому жодного WRITE_EXTERNAL_STORAGE
         тут немає: на API 29+ він зайвий і лише плутає користувача. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TesseraCamera">

        <activity
            android:name=".CameraActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Редактор відкривається на один знімок і ніколи не запускається
             ззовні, тому exported="false". -->
        <activity
            android:name=".EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:label="@string/editor_title"
            android:parentActivityName=".CameraActivity" />
    </application>
</manifest>
