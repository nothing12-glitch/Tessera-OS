<?xml version="1.0" encoding="UTF-8"?>
<!--
  Додатковий маніфест TesseraOS.

  Це НЕ повний маніфест і не повинен ним бути: повне дерево на 1 000+ проєктів
  належить базі. Ставимо наш шар ПОВЕРХ маніфеста LineageOS 22.2 — так само
  роблять усі деривативи. Механізм — `.repo/local_manifests/`: repo зчитує
  файли з цієї теки разом із upstream `default.xml`, тому форкати чужий
  маніфест не треба.

  Перевірені координати бази (2026-10-24, клонуванням дерева):
    маніфест: https://github.com/LineageOS/android.git
    гілка:    lineage-22.2  (default.xml, remote `github` з fetch=".." → github.com)
    наш шар   → vendor/tessera/os, linkfile → device/tessera/x86_64/

  Повна послідовність — build/scripts/new-tree.sh; пояснення — docs/BUILD.md.
-->
<manifest>
  <remote name="tessera" fetch="https://github.com/" />

  <!-- Конфіг продукту і оголошення lunch-таргетів. AOSP шукає продукти в усіх
       device/**/AndroidProducts.mk (build/make/core/product_config.mk:150-152),
       тому обидва файли мають опинитися в каталозі платформи; linkfile робить
       це сам при `repo sync`.

       Властивості бренду (ro.tessera.*) тримаємо в конфізі продукту, а не в
       сусідньому system.prop: AOSP зливає system.prop лише з каталогу, який
       Soong визначає для платформи, тож файл поза тим каталогом мовчки
       лишився б у дереві, не потрапивши в образ. -->
  <project name="nothing12-glitch/tessera-os" remote="tessera" revision="main"
           path="vendor/tessera/os">
    <linkfile src="build/tessera.mk"
              dest="device/tessera/x86_64/tessera_x86_64.mk" />
    <linkfile src="build/board/AndroidProducts.mk"
              dest="device/tessera/x86_64/AndroidProducts.mk" />
  </project>
</manifest>
