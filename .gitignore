# Gradle-білди наших застосунків (корінь `build/` — це наш AOSP-шар, його
# не чіпаємо, тому шаблон привʼязаний до apps/).
.gradle/
local.properties
apps/*/.gradle/
apps/*/build/
apps/*/app/build/
apps/*/app/.kotlin/
apps/*/.kotlin/
apps/*/prebuilt/

# Тимчасове робоче дерево гілки gh-pages, яке створює publish-site.sh.
.pages-worktree/

# Повні варіативні TTF брендових шрифтів: їх дістає
# build/scripts/fetch-brand-fonts.sh і звіряє за сумою. У репо лишаються
# маленькі woff2-підмножини для сайту та тексти ліцензій OFL.
brand/fonts/*.ttf

# Ключі підпису — ніколи не в git
