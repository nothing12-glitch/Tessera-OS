<?xml version="1.0" encoding="utf-8"?>
<!--
  Static RRO: Material Design 3 для Android framework.
  targetPackage="android" => змінюємо ресурси frameworks/base/core/res.

  Умова активації — навмисне «0». Стоковий Android 15 бере кольори зі
  шпалер (Monet), і саме це дає той вигляд, який усі впізнають. Якби ми
  перекривали Theme.DeviceDefault за замовчуванням, система виглядала б
  пласко й не як сток. Ми — fallback: перший запуск, AOD, безпечний режим
  або Monet, свідомо вимкнений користувачем.

  Зверни увагу: імена токенів (colorPrimary, *Container, shapeAppearance)
  відрізняються між релізами Android. Перевір свій checkout у
  frameworks/base/core/res/res/values/colors_device_defaults.xml та
  styles_device_defaults.xml, перш ніж чекати ефекту.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="os.tessera.theme.framework"
    android:versionCode="1503"
    android:versionName="15.22.2.0">

    <overlay
        android:targetPackage="android"
        android:priority="700"
        android:isStatic="true"
        android:requiredSystemPropertyName="persist.tessera.dynamic_color"
        android:requiredSystemPropertyValue="0" />

    <!-- Тема не містить коду і не має компонентів. -->
    <application android:hasCode="false" android:label="TesseraOS MD3 (framework fallback)" />
</manifest>
