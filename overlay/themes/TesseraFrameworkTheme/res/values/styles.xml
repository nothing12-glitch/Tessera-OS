<?xml version="1.0" encoding="utf-8"?>
<!--
  Оверлей стилів DeviceDefault: саме тут значення палітри стають видимими.

  Список атрибутів перевірено проти бази LineageOS 22.2, а не «за чутками»:
    core/res/res/values/public-final.xml  →  public attr
      colorPrimary, colorSecondary, colorError, colorBackground,
      colorAccent, windowLightStatusBar  — усі присутні
    core/res/res/values/attrs.xml
      colorSurface (рядок 1178)        — declared, але НЕ public
      colorSurfaceVariant (1184)       — declared, але НЕ public

  Наслідок: два останні items у кожному стилі збираються лише всередині
  дерева AOSP, де aapt2 лінкує оверлей проти повних символів framework-res.
  Поза деревом build/scripts/build-themes.sh видаляє styles.xml, тому
  невалідований файл у CI просто не перевіряється — див. docs/THEME-MD3.md.
-->
<resources>
    <style name="Theme.DeviceDefault.Light"
           parent="@*android:style/Theme.DeviceDefault.Light">
        <item name="colorPrimary">@color/tesseraPrimary</item>
        <item name="colorSecondary">@color/tesseraSecondary</item>
        <item name="colorAccent">@color/tesseraAccent</item>
        <item name="colorError">@color/tesseraError</item>
        <item name="colorBackground">@color/tesseraBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Тільки для збірки в дереві: private-атрибути framework. -->
        <item name="colorSurface">@color/tesseraSurface</item>
        <item name="colorSurfaceVariant">@color/tesseraSurfaceVariant</item>
    </style>

    <style name="Theme.DeviceDefault" parent="@*android:style/Theme.DeviceDefault">
        <item name="colorPrimary">@color/tesseraPrimary</item>
        <item name="colorSecondary">@color/tesseraSecondary</item>
        <item name="colorAccent">@color/tesseraAccent</item>
        <item name="colorError">@color/tesseraError</item>
        <item name="colorBackground">@color/tesseraBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorSurface">@color/tesseraSurface</item>
        <item name="colorSurfaceVariant">@color/tesseraSurfaceVariant</item>
    </style>

    <!--
      Чого тут свідомо немає:
      - colorOn*, *Container, colorSurfaceContainer*, colorOutline — таких
        атрибутів у framework не існує взагалі; це атрибути бібліотеки
        Material і SettingsLib, їх фарбує застосунок, не система;
      - shapeAppearance* — теж style-ресурси Material, не dimen.
      Геометрію дивись у overlay/themes/TesseraIconShapeTheme (config_icon_mask)
      і в dimens.xml як документацію для власних застосунків.
    -->
</resources>
