<?xml version="1.0" encoding="utf-8"?>
<!--
  Оверлей стилів DeviceDefault. Саме тут значення палітри стають видимими:
  RRO перевизначає items у існуючих style/theme ресурсах пакету `android`.

  Темна тема не дублюється в цьому файлі: ті самі імена ресурсів
  резолвляться через res/values-night/colors.xml, коли система в dark mode.

  ПЕРЕД ЗБІРКОЮ звір список атрибутів зі своїм checkout:
    frameworks/base/core/res/res/values/styles_device_defaults.xml
    frameworks/base/core/res/res/values/attrs.xml
  Атрибути surfaceContainer* та shapeAppearance* з'явилися у новіших
  релізах; для старішої гілки прибрати відповідні items.
-->
<resources>
    <style name="Theme.DeviceDefault.Light"
           parent="@*android:style/Theme.DeviceDefault.Light">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorSurfaceContainerLow">@color/colorSurfaceContainerLow</item>
        <item name="colorSurfaceContainerHigh">@color/colorSurfaceContainerHigh</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.DeviceDefault" parent="@*android:style/Theme.DeviceDefault">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!--
      Геометрія MD3 задається окремими style-ресурсами shapeAppearance*,
      а не dimen-атрибутами; власні назви не резолвляться у framework,
      тому вони лишаються у dimens.xml як документація для дизайну і
      застосовуються через наші власні застосунки (apps/, Compose M3).
    -->
</resources>
