<?xml version="1.0" encoding="utf-8"?>
<!--
  Оверлей Material Design 3 для застосунку Settings.
  Цільовий пакет у LineageOS — com.android.settings; стилі, які ми
  перевизначаємо, лежать у packages/apps/Settings/res/values/styles*.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="os.tessera.theme.settings"
    android:versionCode="1502"
    android:versionName="15.22.2.1">

    <overlay
        android:targetPackage="com.android.settings"
        android:priority="700"
        android:isStatic="true" />

    <application android:hasCode="false" android:label="Tessera MD3 (Settings)" />
</manifest>
