<?xml version="1.0" encoding="utf-8"?>
<!--
  Static RRO для AOSP-лаунчера (Launcher3).
  Саме тут народжується «вигляд як у стоку»: круглі adaptive-іконки,
  сітка 5x6, док на 4 іконки. Це ресурси AOSP Launcher3 (Apache-2.0), а не
  пропрієтарний лаунчер із прошивок Google — такий у проєкт не входить
  і входити не може.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="os.tessera.theme.launcher3"
    android:versionCode="1503"
    android:versionName="15.22.2.0">

    <overlay
        android:targetPackage="com.android.launcher3"
        android:priority="700"
        android:isStatic="true" />

    <application android:hasCode="false" android:label="TesseraOS (Launcher3)" />
</manifest>
