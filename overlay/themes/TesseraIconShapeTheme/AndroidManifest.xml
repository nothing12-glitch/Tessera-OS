<?xml version="1.0" encoding="utf-8"?>
<!--
  Static RRO: форма adaptive-іконок.

  Це єдиний підтверджений механізм, який реально наближає вигляд до
  сучасного стоку без форку будь-чого: круглі іконки замість squircle.
  Обидва ресурси існують у базі, перевірено проти LineageOS 22.2
  (frameworks/base/core/res/res/values/config.xml:4526 і :4626).

  Увага: ці ресурси приватні (@*android:...). Оверлей приватних ресурсів
  цільового пакету — легальний і штатний механізм RRO, саме так OEM-виробники
  задають форму іконок. Але збирати цей пакет треба всередині дерева AOSP,
  де aapt2 бачить exported-символи framework.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="os.tessera.theme.iconshape"
    android:versionCode="1503"
    android:versionName="15.22.2.1">

    <overlay
        android:targetPackage="android"
        android:priority="710"
        android:isStatic="true" />

    <application android:hasCode="false" android:label="TesseraOS (icon shape)" />
</manifest>
